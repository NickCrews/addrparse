{
  "name": "addrparse",
  "private": true,
  "type": "module",
  "scripts": {
    "data": "node src/data/fetch.ts && node src/data/build.ts",
    "data:fetch": "node src/data/fetch.ts",
    "data:build": "node src/data/build.ts",
    "data:override": "node src/data/override.ts",
    "eval": "node src/eval/run.ts",
    "compare": "node src/eval/compare.ts",
    "errors": "node src/eval/errors.ts",
    "test": "node --test 'test/**/*.test.ts'",
    "typecheck": "tsc",
    "fmt": "oxfmt",
    "check": "oxfmt --check && tsc && node --test 'test/**/*.test.ts'"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "oxfmt": "^0.77.0",
    "typescript": "^5.9.0"
  },
  "engines": {
    "node": ">=24"
  }
}
